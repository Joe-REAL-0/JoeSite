{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joesite",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "joe-site-db-preview",
        "database_id": "9f45cdb0-535f-403f-a2ec-15653dbcf042"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "INTERACTIONS",
        "id": "1d32931d9cab4c7b8dfab2697b952640"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joe-site-db",
      "database_id": "af88bc16-7f6d-45c5-8d06-33b0658fb9f4",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "INTERACTIONS",
      "id": "c0c0d580ade448c58c5a606816e6fe7a"
    }
  ]
}
