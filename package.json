{
  "name": "joesite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Joe 的个人小站：Eleventy 静态站点，构建产物 dist/ 可直接由任意静态服务器托管",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test test/*.test.mjs",
    "import-content": "node scripts/import-content.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "sanitize-html": "^2.18.2"
  },
  "engines": {
    "node": ">=20"
  }
}
