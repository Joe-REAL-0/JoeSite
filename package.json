{
  "name": "joesite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Joe 的个人小站，使用 Astro + Svelte 构建静态页面",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "astro dev",
    "preview": "astro preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test test/*.test.mjs",
    "import-content": "node scripts/import-content.mjs"
  },
  "devDependencies": {
    "@astrojs/svelte": "^9.1.6",
    "astro": "^7.4.13",
    "gray-matter": "^4.0.3",
    "svelte": "^5.43.6",
    "typescript": "^6.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "sanitize-html": "^2.18.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
