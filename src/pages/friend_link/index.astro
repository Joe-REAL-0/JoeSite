---
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { loadFriends } from "../../../scripts/content.mjs";
import "../../assets/css/html-style/friend_link.css";
import "../../assets/css/animations/animation-friend_link.css";
import "../../assets/css/mobile-adaption.css";
import "../../assets/css/theme.css";

const friends = loadFriends(path.join(process.cwd(), "src", "_data", "friends.json"));
---

<Base
  title="Joe的个人小站 | 友情链接"
  description="Joe 的友情链接：站主的友邻站点与申请方式。"
  canonical="https://furryjoe.site/friend_link/"
  pageTitle="友情链接"
>
  <section class="page-section" id="friend_link_section">
    <div class="CenterContainer">
      <div id="friend_link_panel" class="cyber-frame">
        <div id="friend_link_container_wrapper">
          <div id="friend_link_container">
            {friends.length ? friends.map((link) => (
              <div class="FriendLink cyber-frame">
                <img src={link.avatar} width="64" height="64" alt={`${link.name}的头像`} />
                <div class="info">
                  <p class="nickname">{link.name}</p>
                  <p class="link"><a href={link.url} target="_blank" rel="noopener noreferrer">{link.url}</a></p>
                </div>
              </div>
            )) : (
              <div class="no-links"><p>尚未添加友情链接</p></div>
            )}
          </div>
        </div>

        <div id="add_link_container">
          <a id="apply_friend_link" class="cyber-control" href="/friend_link/apply/">申请友情链接</a>
        </div>
        <p id="friend_login_status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>
  <script src="../../assets/js/friend_link.js"></script>
</Base>
