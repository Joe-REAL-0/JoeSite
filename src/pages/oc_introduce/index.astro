---
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { loadOc } from "../../../scripts/content.mjs";
import "../../assets/css/html-style/oc_introduce.css";
import "../../assets/css/animations/animation-oc_introduce.css";
import "../../assets/css/mobile-adaption.css";
import "../../assets/css/theme.css";

const sections = loadOc(path.join(process.cwd(), "src", "oc"));
---

<Base
  title="Joe的个人小站 | 档案馆"
  description="Joe 的角色档案馆：角色、势力、技术与世界设定。"
  canonical="https://furryjoe.site/oc_introduce/"
  pageTitle="档案馆"
>
  <div class="CenterContainer">
    <div class="page-header"></div>
    <div id="oc_introduce_panel" class="cyber-frame">
      <button id="sidebar-toggle" class="cyber-control" type="button" aria-label="切换侧边栏" aria-controls="sidebar" aria-expanded="false">☰</button>
      <nav id="sidebar" class="cyber-frame" aria-label="档案目录">
        <ul id="title-list">
          {sections.map((section) => (
            <li><a class="TextTitle cyber-control" data-anchor={section.anchor} href={`#${section.anchor}`}>{section.title}</a></li>
          ))}
        </ul>
      </nav>
      <div id="content-container" class="cyber-frame">
        <div id="output">
          {sections.map((section) => (
            <section id={section.anchor} aria-labelledby={`${section.anchor}-title`}>
              <h2 id={`${section.anchor}-title`}>{section.title}</h2>
              {section.paragraphs.map((paragraph) => (
                <p class="content-paragraph">{paragraph.map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</p>
              ))}
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
  <script src="../../assets/js/oc_introduce.js"></script>
</Base>
