---
import Base from "../../layouts/Base.astro";
import site from "../../_data/site.json";
import { readBlog } from "../../lib/blog.js";
import "../../assets/css/html-style/blog_detail.css";
import "../../assets/css/html-style/interactions.css";
import "../../assets/css/animations/animation-blog.css";
import "../../assets/css/mobile-adaption.css";
import "../../assets/css/theme.css";

export function getStaticPaths() {
  return readBlog().posts.map((post) => ({ params: { id: String(post.id) }, props: { post } }));
}
const { post } = Astro.props;
---
<Base
  title={`${post.title} | Joe的博客`}
  description={post.summary}
  canonical={site.url + post.url}
  ogType="article"
  pageTitle="博客详情"
>
  <Fragment slot="head">
    <script is:inline>
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']],
          processEscapes: true,
          processEnvironments: true
        },
        options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'] }
      };
    </script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
  </Fragment>
  <div class="CenterContainer">
    <article class="blog-detail-container cyber-frame">
      <div class="blog-header">
        <h1 class="blog-title">{post.title}</h1>
        <a href="/blog/" class="back-btn cyber-control">← 返回博客列表</a>
        <div class="blog-meta">
          <span class="blog-date">发布于: {post.createdTime}</span>
          {post.updatedTime && post.updatedTime !== post.createdTime && (
            <span class="blog-updated">更新于: {post.updatedTime}</span>
          )}
        </div>
      </div>
      <div class="blog-content markdown-body" set:html={post.html}></div>
      <section class="interaction-panel" id="interactionPanel" data-post-id={post.id} aria-labelledby="commentsTitle" tabindex="-1">
        <form id="commentForm">
          <label for="commentInput">发表评论</label>
          <textarea id="commentInput" name="content" maxlength="2000" placeholder="通过 GitHub 登录后发表评论" required disabled></textarea>
          <div class="comment-actions">
            <div class="comment-user" id="commentUser" hidden>
              <img id="commentAvatar" alt="" hidden />
              <span id="commentUserName"></span>
            </div>
            <button class="cyber-control" type="submit" disabled>通过GitHub登录</button>
          </div>
        </form>
        <h2 id="commentsTitle">评论</h2>
        <ul id="commentList" role="list"></ul>
        <button type="button" id="loadMoreComments" hidden>加载更多评论</button>
      </section>
    </article>
  </div>
  <aside class="right-sidebar" id="rightSidebar">
    <div class="toc-section cyber-frame" id="tocSection" hidden={!post.toc.length}>
      <div class="toc-header">
        <span class="toc-title">📑 目录</span>
        <button class="toc-toggle cyber-control" id="tocToggle" title="收起目录" aria-controls="tocContent" aria-expanded="true">▲</button>
      </div>
      <nav class="toc-content" id="tocContent" aria-label="文章目录">
        {post.toc.map((item) => (
          <a class={`toc-item toc-h${item.level}`} href={`#${item.id}`} title={item.text}>{item.text}</a>
        ))}
      </nav>
    </div>
    <div class="action-buttons" data-mobile-rail>
      <button class="sidebar-btn interaction-btn cyber-control" id="likeBtn" type="button" title="点赞" aria-label="点赞" aria-pressed="false">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1 7.8 7.8 7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z" /></svg>
        <span class="interaction-count" id="likeCount" aria-hidden="true"></span>
      </button>
      <button class="sidebar-btn interaction-btn cyber-control" id="commentBtn" type="button" title="跳转到评论" aria-label="跳转到评论" aria-controls="interactionPanel">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H11l-6 2 1.7-4.2A8.5 8.5 0 0 1 12 3h.5a8.5 8.5 0 0 1 8.5 8.5Z" /></svg>
        <span class="interaction-count" id="commentCount" aria-hidden="true"></span>
      </button>
      <button class="sidebar-btn top-btn cyber-control" id="topBtn" title="回到顶部" aria-label="回到顶部">
        <span class="btn-icon icon-mask icon-arrow-up"></span>
      </button>
    </div>
  </aside>
  <script>
    import "../../assets/js/blog_detail.js";
    import "../../assets/js/blog_interactions.js";
  </script>
</Base>
