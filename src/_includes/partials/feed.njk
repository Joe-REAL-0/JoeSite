{%- set feedItems = posts.slice(0, 10) -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Joe的个人博客</title>
    <link>{{ site.url }}/blog/</link>
    <description>Joe的个人网站博客 - 技术分享与生活记录</description>
    <language>zh-CN</language>
    <lastBuildDate>{{ buildTime.rfc822 }}</lastBuildDate>
    <atom:link href="{{ site.url }}{{ atomSelf }}" rel="self" type="application/rss+xml"/>
    {%- for post in feedItems %}
    <item>
      <title>{{ post.title | escape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <description>{{ post.summary | escape }}</description>
      <pubDate>{{ post.publishedRfc822 }}</pubDate>
      {%- for tag in post.tags %}
      <category>{{ tag | escape }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
