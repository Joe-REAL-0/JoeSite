{#
  公共布局。
  页面通过 front matter 提供：title / description / canonical / ogType / keywords /
  pageTitle / bodyClass / hideHomeBtn / noindex / styles / headScripts / bodyScripts / inlineHead。
  正文由 {{ content }} 注入——Eleventy 的布局不做块继承。
#}
{% set pageTitleTag = title or site.title %}
{% set pageDescription = description or site.description %}
{% set pageOgType = ogType or "website" %}
<!DOCTYPE html>
<html lang="zh-CN" class="no-js">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="msvalidate.01" content="9884C4626BA4E65D910C18E66CD449A7" />
    <meta name="theme-color" content="#000000">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    {# 脚本可用时立刻去掉 no-js，开屏遮罩才不会在禁用 JS 的浏览器里挡住正文。 #}
    <script>document.documentElement.classList.remove('no-js');</script>

    {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    <meta name="description" content="{{ pageDescription }}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    <meta name="author" content="{{ site.author }}">
    {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}

    <meta property="og:title" content="{{ pageTitleTag }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="{{ pageOgType }}">
    {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
    <meta property="og:site_name" content="{{ site.title }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitleTag }}">
    <meta name="twitter:description" content="{{ pageDescription }}">

    <title>{{ pageTitleTag }}</title>
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">

    {# 只预加载首屏字体与页面关键图；其余按页加载，失败也不阻塞正文。 #}
    <link rel="preload" as="font" type="font/otf" href="/font/GunShi.otf" crossorigin>
    <link rel="preload" as="font" type="font/ttf" href="/font/yuanti.ttf" crossorigin>
    <link rel="preload" as="font" type="font/ttf" href="/font/ZhengQingKeLengKu.ttf" crossorigin>

    {% if inlineHead %}{{ inlineHead | safe }}{% endif %}

    <!-- 全局样式 -->
    <link rel="stylesheet" href="/css/font.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/animations/animation-global.css">

    {% for href in styles %}<link rel="stylesheet" href="{{ href }}">
    {% endfor %}
    <link rel="stylesheet" href="/css/theme.css">

    <!-- 全局脚本 -->
    <script src="/js/theme-toggle.js"></script>
    <script src="/js/global.js"></script>
    <script src="/js/mobile-rail.js" defer></script>

    {% for src in headScripts %}<script src="{{ src }}"></script>
    {% endfor %}
</head>

<body class="themed-bg {{ bodyClass }}">
    <div class="portrait-atmosphere" aria-hidden="true">
        <div class="portrait-particles"></div>
    </div>
    <!-- 加载遮罩 -->
    <div id="cover" role="progressbar" aria-label="资源加载进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="cover-panels" aria-hidden="true">
            <div class="cover-half cover-top"></div>
            <div class="cover-half cover-bottom"></div>
            <div class="cover-progress">
                <span class="cover-line cover-line-left"></span>
                <span class="cover-line cover-line-right"></span>
            </div>
        </div>
        <span id="cover-percentage" aria-hidden="true">0%</span>
    </div>
    <div id="title_container">
        <div id="top_column">
            <div class="top-side left-side">
                <!-- 返回主页按钮 -->
                {% if not hideHomeBtn %}
                <a id="global-home-btn" class="top-btn cyber-control" href="/" title="返回主页">
                    <span class="home-btn-icon"></span>
                </a>
                {% endif %}
            </div>

            <h1>
                <span class="title-surface cyber-frame cyber-cut" aria-hidden="true"></span>
                {{ pageTitle or "JoE's Site" }}
            </h1>

            <div class="top-side right-side">
                <!-- 主题切换按钮 -->
                <button id="theme-toggle" class="top-btn cyber-control" title="切换浅色/深色主题" aria-label="切换主题">
                    <span class="theme-icon-sun"></span>
                    <span class="theme-icon-moon"></span>
                </button>
            </div>
        </div>
        <h2 id="loading_text">—— 正在加载资源 ——</h2>
    </div>

    <!-- 移动端悬浮控制组 -->
    <div id="mobile_controls">
        <!-- 移动端返回主页按钮 -->
        {% if not hideHomeBtn %}
        <a id="global-home-btn-mobile" class="top-btn cyber-control" href="/" title="返回主页">
            <span class="home-btn-icon"></span>
        </a>
        {% endif %}

        <!-- 移动端主题切换按钮 -->
        <button id="theme-toggle-mobile" class="top-btn cyber-control" title="切换浅色/深色主题" aria-label="切换主题">
            <span class="theme-icon-sun"></span>
            <span class="theme-icon-moon"></span>
        </button>
    </div>

    <!-- 页面内容 -->
    {{ content | safe }}

    <!-- 开屏进度：只等首屏字体和页面点名的关键图 -->
    <script>
        (function () {
            var fonts = [
                '/font/GunShi.otf',
                '/font/yuanti.ttf',
                '/font/ZhengQingKeLengKu.ttf',
                '/font/valorax-lg25v.ttf',
                '/font/Technonomicon.ttf'
            ];
            var extra = Array.isArray(window.pageResources) ? window.pageResources : [];
            if (window.globalLoader) {
                window.globalLoader.start(fonts.concat(extra));
            } else {
                // 加载脚本没跑起来时退回 no-js 样式：隐藏遮罩，正文照常可读。
                document.documentElement.classList.add('no-js');
            }
            // 兜底：加载器自身异常也不会把正文永远盖住。
            window.setTimeout(function () {
                var cover = document.getElementById('cover');
                if (!cover) return;
                cover.remove();
                document.body.classList.add('character-revealed');
            }, 12000);
        })();
    </script>

    <script src="/js/particles.js"></script>
    {% for src in bodyScripts %}<script src="{{ src }}"></script>
    {% endfor %}
</body>

</html>
